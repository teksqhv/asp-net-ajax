@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="page-header" style="text-align: center; margin: 2rem 0 3rem 0;">
    <h1 style="font-size: 2.8rem; font-weight: 800; margin-bottom: 0.5rem;">Найди свою первую работу</h1>
    <p style="font-size: 1.2rem; color: #6b7280;">Платформа CollegeJob помогает студентам начать карьеру</p>
</div>

<div class="resume-grid" style="justify-content: center;">
    
    <div class="resume-card" style="text-align: center;">
        <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">Создать резюме</h3>
        <p style="color: #6b7280; margin-bottom: 2rem;">Заполните анкету, укажите свои навыки и специальность. Работодатели смогут найти вас в нашем каталоге.</p>
        <a asp-page="/CreateResume" class="btn btn-primary" style="width: 100%; margin-top: auto;">Начать</a>
    </div>

    <div class="resume-card" style="text-align: center;">
        <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">Каталог студентов</h3>
        <p style="color: #6b7280; margin-bottom: 2rem;">Просмотрите базу талантливых студентов. Удобные карточки помогут найти нужного кандидата.</p>
        <a asp-page="/Resumes" class="btn btn-secondary" style="width: 100%; margin-top: auto; border: 1px solid #d1d5db;">Смотреть каталог</a>
    </div>

    <div class="resume-card" style="text-align: center;">
        <h3 style="font-size: 1.4rem; margin-bottom: 1rem;">О проекте</h3>
        <p style="color: #6b7280; margin-bottom: 2rem;">Мы помогаем студентам начать карьеру, а компаниям — находить молодые и перспективные таланты.</p>
        <a asp-page="/About" class="btn btn-secondary" style="width: 100%; margin-top: auto; border: 1px solid #d1d5db;">Подробнее</a>
    </div>

</div>