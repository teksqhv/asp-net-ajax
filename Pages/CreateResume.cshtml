@page
@model CreateResumeModel
@{
    ViewData["Title"] = "Создать резюме";
}

<div style="max-width: 700px; margin: 0 auto; padding-top: 2rem;">
    
    <div style="margin-bottom: 2rem; text-align: left;">
        <h1 style="font-size: 2.2rem; font-weight: 800; margin: 0 0 0.5rem 0;">Анкета студента</h1>
        <p style="color: #6b7280; font-size: 1.1rem; margin: 0;">Введите свои данные</p>
    </div>

    <div class="resume-card" style="padding: 2.5rem;">
        <form method="post">
            
            <div class="form-group">
                <label asp-for="NewStudent.Name" class="form-label">Имя-фамилия:</label>
                <input asp-for="NewStudent.Name" class="form-control" placeholder="Введите имя" required />
            </div>

            <div class="form-group">
                <label asp-for="NewStudent.Phone" class="form-label">Номер телефона:</label>
                <input asp-for="NewStudent.Phone" class="form-control" placeholder="+7" required />
            </div>

            <div class="form-group">
                <label asp-for="NewStudent.Email" class="form-label">Email:</label>
                <input asp-for="NewStudent.Email" type="email" class="form-control" placeholder="email@example.com" required />
            </div>

            <div class="form-group">
                <label class="form-label d-block">Специальность:</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="NewStudent.Speciality" value="Программирование" id="spec1" checked>
                    <label class="form-check-label" for="spec1">Программирование</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="NewStudent.Speciality" value="Дизайн" id="spec2">
                    <label class="form-check-label" for="spec2">Дизайн</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="NewStudent.Speciality" value="Маркетинг" id="spec3">
                    <label class="form-check-label" for="spec3">Маркетинг</label>
                </div>
            </div>

            <!-- Курс -->
            <div class="form-group">
                <label class="form-label">Курс:</label>
                <select name="NewStudent.Course" class="form-control">
                    <option value="1 курс">1 курс</option>
                    <option value="2 курс">2 курс</option>
                    <option value="3 курс">3 курс</option>
                    <option value="4 курс">4 курс</option>
                </select>
            </div>

            <!-- Дата рождения -->
            <div class="form-group">
                <label asp-for="NewStudent.BirthDate" class="form-label">Дата рождения:</label>
                <input asp-for="NewStudent.BirthDate" type="date" class="form-control" />
            </div>

            <!-- Технологии (чекбоксы) -->
            <div class="form-group">
                <label class="form-label d-block">Технологии:</label>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="NewStudent.Technologies" value="C#" id="tech1">
                        <label class="form-check-label" for="tech1">C#</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="NewStudent.Technologies" value="HTML/CSS" id="tech2">
                        <label class="form-check-label" for="tech2">HTML/CSS</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="NewStudent.Technologies" value="JavaScript" id="tech3">
                        <label class="form-check-label" for="tech3">JavaScript</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="NewStudent.Technologies" value="Python" id="tech4">
                        <label class="form-check-label" for="tech4">Python</label>
                    </div>
                </div>
            </div>

            <!-- Город (Выпадающий список) -->
            <div class="form-group">
                <label class="form-label">Город:</label>
                <select name="NewStudent.City" class="form-control">
                    <option value="Москва">Москва</option>
                    <option value="Санкт-Петербург">Санкт-Петербург</option>
                    <option value="Казань">Казань</option>
                    <option value="Екатеринбург">Екатеринбург</option>
                    <option value="Новосибирск">Новосибирск</option>
                </select>
            </div>

            <!-- Языки (Выпадающий список) -->
            <div class="form-group">
                <label class="form-label">Языки:</label>
                <select name="NewStudent.Lang" class="form-control">
                    <option value="Английский B1">Английский B1</option>
                    <option value="Английский B2">Английский B2</option>
                    <option value="Английский C1">Английский C1</option>
                </select>
            </div>

            <!-- Форма обучения (Выпадающий список) -->
            <div class="form-group">
                <label class="form-label">Форма обучения:</label>
                <select name="NewStudent.FormStudy" class="form-control">
                    <option value="Очная">Очная</option>
                    <option value="Заочная">Заочная</option>
                    <option value="Очно-заочная">Очно-заочная</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 2rem;">
                <label asp-for="NewStudent.Info" class="form-label">О себе:</label>
                <textarea asp-for="NewStudent.Info" class="form-control" rows="3" placeholder="Дополнительная информация..."></textarea>
            </div>

            <!-- Кнопки -->
            <div style="display: flex; gap: 1rem;">
                <button type="submit" class="btn btn-primary" style="flex: 1; padding: 0.8rem; font-size: 1.1rem;">Сохранить анкету</button>
                <button type="reset" class="btn btn-secondary" style="padding: 0.8rem 1.5rem; font-size: 1.1rem;">Очистить</button>
            </div>
        </form>
    </div>
</div>